# Copy to .env.local for local development. Values are public (NEXT_PUBLIC_*)
# and are embedded in the client bundle, so never put secrets here.

# Backend that receives contact-form submissions (POST {API_URL}/contact/portfolio).
# Without it the form posts to the Next.js server itself and fails with 404.
NEXT_PUBLIC_API_URL=

# Canonical site origin used for metadata, sitemap and robots.
# Defaults to https://arshadchowdhury.vercel.app when unset.
NEXT_PUBLIC_SITE_URL=
